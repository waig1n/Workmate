# workmate deployment environment template.
# Copy to .env and fill in values; never commit the real .env file.
# Set non-sensitive policy in config/workmate.yaml; default Compose does not forward policy overrides.

# ===== Docker Compose and builds =====
# PostgreSQL superuser/application username.
POSTGRES_USER=workmate
# PostgreSQL password; replace with a strong password in production.
POSTGRES_PASSWORD=change-me-in-production
# Database used by gateway.
POSTGRES_DB=workmate
# Python package index and Docker build download timeout, seconds.
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_DEFAULT_TIMEOUT=120
# Compose project name; existing deployments must retain their original value to reuse data volumes.
COMPOSE_PROJECT_NAME=workmate
# Container-internal gateway URL for the Next.js server proxy (build argument).
PRODUCT_API_URL=http://gateway:8080

# ===== gateway: connections, secrets, and persistent paths =====
# Public Workmate frontend URL for channel, approval, and result links; HTTP/HTTPS supported. HTTPS is recommended in production.
# Used by gateway only; never inferred from request Host or the container-internal PRODUCT_API_URL.
# Local development example: http://localhost:3000. Match custom ports to your Compose configuration.
WORKMATE_PUBLIC_URL=
# Gateway database connection; password must match POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://workmate:change-me-in-production@postgres:5432/workmate
# Absolute Alembic configuration path for the RBAC migration CLI; fixed at this path in Compose images.
# A deployment path, not business policy; contains no secrets and does not belong in config/workmate.yaml.
WORKMATE_ALEMBIC_CONFIG=/app/alembic.ini
# Product uses only the Worker knowledge-management API; an internal load balancer for ready Workers is supported.
RUNTIME_BASE_URL=http://runtime:8000
# JWT signing secret; at least 32 random bytes are recommended in production.
JWT_SECRET=replace-with-at-least-32-random-bytes
# Shared secret for the Product-to-Worker knowledge-management API; must match on both sides.
# Compose maps this to Product RUNTIME_INTERNAL_TOKEN and Worker WORKMATE_INTERNAL_TOKEN.
# Empty denies management access; does not replace Task worker/epoch fencing.
# Use a random value; never store it in config/workmate.yaml.
WORKMATE_INTERNAL_TOKEN=replace-with-a-random-secret
# Persistent artifact directory inside the gateway container.
ARTIFACT_STORAGE_DIR=/data/artifacts

# ===== Immutable Skill packages: shared by Product API and Worker =====
# Default Compose RustFS endpoint; HTTP(S) only, with no userinfo, query, or fragment.
SKILL_S3_ENDPOINT=http://rustfs:9000
# Separate private bucket, distinct from KNOWLEDGE_S3_BUCKET; default workmate-skills.
SKILL_S3_BUCKET=workmate-skills
# For local deployments, use the same values as RustFS KNOWLEDGE_S3_ACCESS_KEY/SECRET_KEY below.
# External S3 requires dedicated bucket credentials; never passed through Agent sandboxes/ExecutionSpec, with no knowledge credential fallback.
SKILL_S3_ACCESS_KEY=
SKILL_S3_SECRET_KEY=
# Separate rebuildable Worker cache; Compose persists it on the worker-data volume by default.
WORKMATE_SKILL_CACHE_DIR=/worker-data/skill-cache

# ===== runtime: knowledge indexing connections =====
# Auxiliary knowledge indexing database; initialization creates workmate_agentscope.
AS_DATABASE_URL=postgresql+asyncpg://workmate:change-me-in-production@postgres:5432/workmate_agentscope
# Knowledge indexing message bus; uses separate Redis DB 0.
AS_REDIS_URL=redis://redis:6379/0
# Gateway/Worker command delivery and notification connection; separate deployments need separate Redis instances.
# Pub/Sub channels are not isolated by Redis database number.
# Command/event namespaces must match across roles in one deployment and remain isolated from other environments.
WORKMATE_COORDINATION_NAMESPACE=workmate
WORKMATE_COORDINATION_REDIS_URL=redis://redis:6379/0
# Set provider endpoints when product.web.enabled=true. Local Crawl4AI requires a token.
# Internal Compose web profile endpoints; override for external services, never use localhost for container peers.
WEB_SEARCH_BASE_URL=http://searxng:8080
WEB_FETCH_BASE_URL=http://crawl4ai:11235
# Required for SearXNG startup; generate with openssl rand -hex 32. Never commit real secrets.
SEARXNG_SECRET=
# Required for local Crawl4AI 0.9.2; without a token it binds only to container loopback and Runtime cannot connect.
# Compose also maps this to server CRAWL4AI_API_TOKEN; generate with openssl rand -hex 32.
WEB_FETCH_API_TOKEN=
# Optional GitHub MCP Hub credentials; ClawHub is disabled.
# Product API accesses the public GitHub MCP catalog directly; the optional token is only for catalog rate limits.
GITHUB_TOKEN=

# ===== Model secrets =====
# api_key_env in config/workmate.yaml references these variable names.
# For multiple models, each profile can reference a different api_key_env variable;
# for example, declare KIMI_API_KEY and reference it in an additional profile.
CHAT_MODEL_API_KEY=
EMBEDDING_MODEL_API_KEY=

# Configure model identity (type/name/capabilities/context window) only in workmate.yaml profiles.
# Environment variables hold secrets and gateway URLs, not model identity overrides. Profiles use
# base_url_env to reference the variable names below.
CHAT_MODEL_BASE_URL=
# Embedding profiles likewise reference these variables through base_url_env.
EMBEDDING_MODEL_BASE_URL=

# Knowledge: first enable product.knowledge.enabled in config/workmate.yaml.
# Service URLs and private bucket; only Runtime receives these credentials.
KNOWLEDGE_QDRANT_URL=http://qdrant:6333
KNOWLEDGE_QDRANT_API_KEY=
KNOWLEDGE_S3_ENDPOINT=http://rustfs:9000
KNOWLEDGE_S3_BUCKET=workmate-knowledge
# Local Compose RustFS root credentials; use dedicated bucket credentials for external S3.
KNOWLEDGE_S3_ACCESS_KEY=
KNOWLEDGE_S3_SECRET_KEY=

# Knowledge RAG embedding credentials, separate from ReMe EMBEDDING_MODEL_*.
# Configure the key when product.knowledge.enabled is true; empty URL uses the provider SDK default.
KNOWLEDGE_EMBEDDING_MODEL_API_KEY=
KNOWLEDGE_EMBEDDING_MODEL_BASE_URL=

# ===== Native runtime: persistence and backend connections =====
# Stable storage-mount identity shared by Product admission and the target Worker; at most 64 characters,
# starting with an alphanumeric character, followed by alphanumerics/dots/underscores/hyphens. Product/Compose default: local-worker-storage; required by Worker CLI.
# Not an ephemeral container/process ID. Different local mounts must not reuse an identity.
WORKMATE_WORKER_STORAGE_NODE_ID=local-worker-storage
# Sandbox backend and idle reclamation are configured in YAML; only the selected backend uses these connections.
# Docker backend only; defaults to the local socket. Explicitly mount into Worker, never into Agent containers.
DOCKER_HOST=unix:///var/run/docker.sock
# Kubernetes client configuration path; empty uses in-cluster identity. Containers require an explicit read-only file mount.
WORKMATE_SANDBOX_KUBECONFIG=
# E2B credentials; Worker service only, never forwarded to the Agent environment.
E2B_API_KEY=
# Self-hosted E2B domain; empty uses the SDK default. No scheme or path.
E2B_DOMAIN=
# Daytona credentials; Worker service only.
DAYTONA_API_KEY=
# Self-hosted Daytona API URL; empty uses the SDK default.
DAYTONA_API_URL=
# OpenSandbox credentials; Worker service only.
OPEN_SANDBOX_API_KEY=
# OpenSandbox service host:port; empty uses the SDK default. Protocol is configured in YAML.
OPEN_SANDBOX_DOMAIN=
# Persistent Worker directory; different storage nodes must not share a directory identity.
WORKMATE_WORKER_WORKSPACE_BASEDIR=/worker-data/workspaces
WORKMATE_WORKER_REME_BASEDIR=/worker-data/reme
# Compose container shutdown grace (s/m units); default 90s. Increase alongside the Worker drain timeout.
WORKMATE_WORKER_STOP_GRACE_PERIOD=90s

# Multi-machine Gateway node directory as JSON; empty uses the WORKMATE_WORKER_STORAGE_NODE_ID single-node mode.
# Nonempty requires product.artifacts.storage.backend=s3. enabled=false stops new user/Agent assignments to that node.
WORKMATE_WORKER_NODES=[]
# Separate private artifact/attachment bucket; required for S3 mode, never shared with Skill or knowledge buckets.
# Required for artifact S3 or tool_content_enabled; external tool content does not require migrating local artifacts.
ARTIFACT_S3_ENDPOINT=http://rustfs:9000
ARTIFACT_S3_BUCKET=workmate-artifacts
ARTIFACT_S3_ACCESS_KEY=
ARTIFACT_S3_SECRET_KEY=
